    <line x1="254" y1="154" x2="294" y2="154" class="stroke-border" stroke-width="1" />
    <text x="300" y="158" font-size="11" class="fill-foreground">banda 2 · vicino infrarosso</text>
    <rect x="94" y="164" width="132" height="88" class="fill-background" />
    <rect x="160" y="186" width="22" height="22" class="fill-foreground" opacity="0.45" />
    <line x1="94" y1="164" x2="94" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="116" y1="164" x2="116" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="138" y1="164" x2="138" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="160" y1="164" x2="160" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="182" y1="164" x2="182" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="204" y1="164" x2="204" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="226" y1="164" x2="226" y2="252" class="stroke-border" stroke-width="0.8" />
    <line x1="94" y1="164" x2="226" y2="164" class="stroke-border" stroke-width="0.8" />
