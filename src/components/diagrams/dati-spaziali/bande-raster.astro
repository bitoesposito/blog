    <line x1="150" y1="144" x2="282" y2="144" class="stroke-border" stroke-width="0.8" />
    <rect x="150" y="56" width="132" height="88" fill="none" class="stroke-muted-foreground" stroke-width="1.2" />
    <line x1="282" y1="100" x2="294" y2="100" class="stroke-border" stroke-width="1" />
    <text x="300" y="104" font-size="11" class="fill-foreground">banda 1 · visibile</text>
    <rect x="122" y="110" width="132" height="88" class="fill-background" />
    <rect x="188" y="132" width="22" height="22" class="fill-foreground" opacity="0.45" />
    <line x1="122" y1="110" x2="122" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="144" y1="110" x2="144" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="166" y1="110" x2="166" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="188" y1="110" x2="188" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="210" y1="110" x2="210" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="232" y1="110" x2="232" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="254" y1="110" x2="254" y2="198" class="stroke-border" stroke-width="0.8" />
    <line x1="122" y1="110" x2="254" y2="110" class="stroke-border" stroke-width="0.8" />
